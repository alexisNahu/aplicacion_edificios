---
import Layout from "../../layouts/Layout.astro";
import ReadInquilino from "../../features/inquilinos/components/crud/Read";

const { id } = Astro.params;
---

<Layout title={`Inquilino #${id} - Gestión Inmobiliaria`}>
    <main>
        <ReadInquilino id={id} client:only="react" />
    </main>
</Layout>

<style>
    main {
        min-height: 100vh;
        background-color: #f9fafb;
    }
</style>
