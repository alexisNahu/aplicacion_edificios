---
import Layout from "../../layouts/Layout.astro";
import ReadInquilino from "../../features/inquilinos/components/crud/Read";

export async function getStaticPaths() {
    const response = await fetch('http://localhost:8000/api/inquilinos/');
    const result = await response.json();
    const inquilinos = result.data;

    return inquilinos.map((inquilino: any) => ({
        params: { id: inquilino.id.toString() },
    }));
}

const { id } = Astro.params;
---

<Layout title={`Inquilino #${id} - Gestión Inmobiliaria`}>
    <main>
        <ReadInquilino id={id} client:only="react" />
    </main>
</Layout>

<style>
    main {
        min-height: 100vh;
        background-color: #f9fafb;
    }
</style>
