---
import Layout from "@/layouts/Layout.astro";
import EditarContrato from "../../../features/contratos/components/crud/EditarContrato";
import {ContratosService} from "../../../core/services/contratos/services";
// 1. IMPORTA EL SERVICIO (NO EL HOOK)

export async function getStaticPaths() {
    // 2. LLAMA AL SERVICIO DIRECTAMENTE
    const response = await ContratosService.get({});
    const contratos = response.data; // Ajusta según tu estructura

    return contratos.map((contrato: any) => ({
        params: { id: contrato.id.toString() },
    }));
}

const { id } = Astro.params;
---

<Layout title={`Editar Contrato #${id}`}>
    <main>
        <EditarContrato id={id!} client:only="react" />
    </main>
</Layout>
