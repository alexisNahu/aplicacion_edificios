---
import Layout from "../../layouts/Layout.astro";
import DetalleContrato from "../../features/contratos/components/crud/DetalleContrato";

const { id } = Astro.params;
---

<Layout title={`Contrato #${id} - Gestión Inmobiliaria`}>
    <main>
        <DetalleContrato id={id} client:only="react" />
    </main>
</Layout>

<style>
    main {
        min-height: 100vh;
        background-color: #f9fafb;
    }
</style>
