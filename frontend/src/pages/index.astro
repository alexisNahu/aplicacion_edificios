---
import Layout from "../layouts/Layout.astro";

const token = Astro.cookies.get("access_token");

console.log(token)

if (!token) {
    return Astro.redirect("/auth/login");
}
---

<Layout>
    <div class="min-h-screen bg-gray-100 flex flex-col items-center justify-center p-6">
        <div class="max-w-2xl w-full text-center">

            <h1 class="text-4xl font-bold text-gray-800 mb-2">Panel de Control</h1>
            <p class="text-gray-600 mb-10">Selecciona el módulo al que deseas acceder:</p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                <a
                        href="/contratos"
                        class="block p-8 bg-white rounded-2xl shadow-sm border border-gray-200 hover:shadow-xl hover:border-blue-400 transition-all duration-300 transform hover:-translate-y-1"
                >
                    <div class="text-blue-600 mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                    </div>
                    <h2 class="text-xl font-semibold text-gray-800">Contratos</h2>
                    <p class="text-gray-500 mt-2 text-sm">Gestionar alquileres y pagos.</p>
                </a>

                <a
                        href="/inquilinos"
                        class="block p-8 bg-white rounded-2xl shadow-sm border border-gray-200 hover:shadow-xl hover:border-emerald-400 transition-all duration-300 transform hover:-translate-y-1"
                >
                    <div class="text-emerald-600 mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                        </svg>
                    </div>
                    <h2 class="text-xl font-semibold text-gray-800">Inquilinos</h2>
                    <p class="text-gray-500 mt-2 text-sm">Administrar base de datos de inquilinos.</p>
                </a>

            </div>

            <div class="mt-12">
                <button
                        id="logoutBtn"
                        class="text-gray-500 hover:text-red-600 transition-colors text-sm font-medium flex items-center justify-center mx-auto gap-2"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                    </svg>
                    Cerrar sesión
                </button>
            </div>
        </div>
    </div>
</Layout>

<script>
    const BACKEND_API = import.meta.env.PUBLIC_BACKEND_API;

    document.getElementById('logoutBtn')?.addEventListener('click', async () => {
        try {
            // Asegúrate de que esta URL coincida con tu endpoint de logout en FastAPI
            await fetch(`${BACKEND_API}/auth/logout`, {
                method: 'POST',
                credentials: 'include' // Envía la cookie para que el servidor pueda borrarla
            });
            window.location.href = '/login';
        } catch (err) {
            console.error("Error al salir:", err);
        }
    });
</script>
