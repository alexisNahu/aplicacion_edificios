---
// pages/edificios/[id]/editar.astro
import Layout from "@/layouts/Layout.astro";
import UpdateEdificio from "@/features/edificios/components/crud/Update";

const { id } = Astro.params;
---

<Layout title={`Editar Edificio #${id} - Gestión Inmobiliaria`}>
    <main>
        {/* Renderizado del componente de React para la edición */}
        {/* Usamos client:only="react" para asegurar que los hooks de TanStack Query funcionen en el cliente */}
        <UpdateEdificio id={id!} client:only="react" />
    </main>
</Layout>

<style>
    main {
        min-height: 100vh;
        background-color: #f9fafb;
    }
</style>
