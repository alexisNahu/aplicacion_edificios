---
import '../styles/global.css'
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
	</head>
	<body>
	<nav class="bg-white border-b border-gray-200 sticky top-0 z-40">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="flex justify-between h-16">

				<!-- Logo / Nombre -->
				<div class="flex items-center">
					<a href="/" class="text-xl font-bold text-blue-600">Edificios App</a>
				</div>

				<!-- Links de navegación -->
				<div class="flex items-center space-x-6">
					<a href="/contratos" class="text-gray-600 hover:text-blue-600 font-medium transition-colors">Contratos</a>
					<a href="/inquilinos" class="text-gray-600 hover:text-emerald-600 font-medium transition-colors">Inquilinos</a>
				</div>

				<!-- Botón Logout -->
				<div class="flex items-center">
					<button
						id="navLogoutBtn"
						class="text-sm text-gray-500 hover:text-red-600 transition-colors"
					>
						Salir
					</button>
				</div>
			</div>
		</div>
	</nav>

	<script>
		const BACKEND_API = import.meta.env.PUBLIC_BACKEND_API;

		document.getElementById('navLogoutBtn')?.addEventListener('click', async () => {
			try {
				// 1. Llamada al backend para invalidar la sesión (si tu backend maneja blacklist o similar)
				await fetch(`${BACKEND_API}/auth/logout`, {
					method: 'POST',
					credentials: 'include' // Esto hace que el servidor reciba y borre la cookie
				});

				// 2. Limpieza forzada en el cliente (por seguridad extra)
				// Esto asegura que si el servidor falló, el cliente al menos borre su vista local
				document.cookie = "access_token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
				document.cookie = "refresh_token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";

				// 3. Redirección inmediata
				window.location.href = '/auth/login';
			} catch (err) {
				console.error("Error al salir:", err);
				// Incluso si hay error de red, forzamos la salida para no dejar al usuario "atrapado"
				window.location.href = '/auth/login';
			}
		});
	</script>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
